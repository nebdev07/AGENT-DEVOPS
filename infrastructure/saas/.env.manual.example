# Copier en .env.manual — tests manuels / démo (profil saas-manual).
# docker compose -f docker-compose.yml -f compose.manual.yml --env-file .env.manual up -d --build

AUTOPILOT_PUBLIC_URL=http://127.0.0.1:8092
AUTOPILOT_HTTP_PORT=8092
AUTOPILOT_BOOTSTRAP_ADMIN_EMAIL=ops@manual.test

AUTOPILOT_DB_OWNER_PASSWORD=change-me-owner-manual
AUTOPILOT_DB_PASSWORD=change-me-app-manual
AUTOPILOT_MASTER_KEY=

AUTOPILOT_RUNNER_TOKEN=change-me-runner-token-32chars-min
AUTOPILOT_RUNNER_PRIVATE_KEY_PATH=./runner.key
AUTOPILOT_RUNNER_PUBLIC_KEY=

SPRING_MAIL_HOST=
SPRING_MAIL_PORT=1025

AUTOPILOT_AI_PROVIDER=none
AUTOPILOT_STAFF_MFA_REQUIRED=false
AUTOPILOT_ALLOW_PRIVATE_TARGETS=true
