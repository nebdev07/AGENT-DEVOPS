# Copier en .env.local — tests locaux automatisés / lab (profil saas-local).
# docker compose -f docker-compose.yml -f compose.lab.yml --env-file .env.local up -d --build

AUTOPILOT_PUBLIC_URL=http://127.0.0.1:8091
AUTOPILOT_HTTP_PORT=8091
AUTOPILOT_BOOTSTRAP_ADMIN_EMAIL=admin@local.test

AUTOPILOT_DB_OWNER_PASSWORD=change-me-owner-local
AUTOPILOT_DB_PASSWORD=change-me-app-local
AUTOPILOT_MASTER_KEY=

# Mode local : control plane en saas,local (runner embedded dans le même process via override compose.local.yml)
# Pour la pile complète remote+lab, garder remote + runner.key comme .env.example.

AUTOPILOT_RUNNER_TOKEN=change-me-runner-token-32chars-min
AUTOPILOT_RUNNER_PRIVATE_KEY_PATH=./runner.key
AUTOPILOT_RUNNER_PUBLIC_KEY=

AUTOPILOT_AI_PROVIDER=none
AUTOPILOT_STAFF_MFA_REQUIRED=false
