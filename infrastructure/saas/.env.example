# VPS Autopilot SaaS — copier en .env (jamais commité) et remplir.
# Générer : openssl rand -base64 32 (clé maîtresse), openssl rand -hex 32 (jetons, mots de passe).

AUTOPILOT_PUBLIC_URL=https://app.example.com
AUTOPILOT_HTTP_PORT=8080
# Premier PLATFORM_ADMIN : s'inscrire avec cette adresse, puis redémarrer le control plane.
AUTOPILOT_BOOTSTRAP_ADMIN_EMAIL=

AUTOPILOT_DB_OWNER_PASSWORD=
AUTOPILOT_DB_PASSWORD=

# Clé maîtresse (secrets MFA, anciennes valeurs) : à sauvegarder HORS de la base et hors de ce serveur.
AUTOPILOT_MASTER_KEY=

# Runner séparé (ADR-055)
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out runner.key
#   openssl pkey -in runner.key -pubout -out runner.pub
# La clé PRIVÉE ne va qu'au runner (fichier monté en secret) ; la clé PUBLIQUE va au control plane.
AUTOPILOT_RUNNER_TOKEN=
AUTOPILOT_RUNNER_PRIVATE_KEY_PATH=./runner.key
# Contenu PEM de runner.pub (guillemets doubles, sauts de ligne conservés).
AUTOPILOT_RUNNER_PUBLIC_KEY=

# E-mail (invitations, vérification, réinitialisation)
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# IA (facultatif) : anthropic + clé, sinon conseiller déterministe
AUTOPILOT_AI_PROVIDER=none
AUTOPILOT_AI_API_KEY=

AUTOPILOT_PAYMENT_WEBHOOK_SECRET=
